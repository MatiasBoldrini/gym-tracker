{
  "version": 3,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Robots-Tag": "noindex, nofollow",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(?:bloques(?:/.*)?|)", "dest": "/index.html" }
  ]
}
