{
    "version": 2,
    "installCommand": "npm install && node scripts/build-api.mjs && npm --prefix apps/web install",
    "builds": [
        {
            "src": "apps/web/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "api/[[...path]].js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/[[...path]].js"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}