{
    "installCommand": "npm install && npm --prefix apps/web install",
    "buildCommand": "npm --prefix apps/web run build",
    "outputDirectory": "apps/web/dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}