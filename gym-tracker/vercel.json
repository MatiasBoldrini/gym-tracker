{
    "version": 2,
    "installCommand": "npm install && node scripts/build-api.mjs && npm --prefix apps/web install",
    "builds": [
        {
            "src": "apps/web/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "api/[[...path]].js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/[[...path]].js"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/apps/web/assets/$1"
        },
        {
            "src": "/icons/(.*)",
            "dest": "/apps/web/icons/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/apps/web/images/$1"
        },
        {
            "src": "/manifest.webmanifest",
            "dest": "/apps/web/manifest.webmanifest"
        },
        {
            "src": "/sw.js",
            "dest": "/apps/web/sw.js"
        },
        {
            "src": "/workbox-(.*)\\.js",
            "dest": "/apps/web/workbox-$1.js"
        },
        {
            "src": "/offline.html",
            "dest": "/apps/web/offline.html"
        },
        {
            "src": "/(.*)",
            "dest": "/apps/web/index.html"
        }
    ]
}