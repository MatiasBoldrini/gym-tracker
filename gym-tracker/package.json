{
    "name": "gym-tracker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "npm --prefix apps/web run dev",
        "assign:blocks": "node --experimental-strip-types scripts/assign-block-plan.mjs",
        "build": "node scripts/build-api.mjs && npm --prefix apps/web run build",
        "start": "npm --prefix apps/web run preview",
        "lint": "npm --prefix apps/web run lint && tsc -p tsconfig.json --noEmit",
        "sync:blocks": "node scripts/sync-block-workouts.mjs",
        "test:block-export": "node --experimental-strip-types --test scripts/block-*.test.mjs supabase/tests/block-plan.test.mjs",
        "test:api": "esbuild api-src/_lib/google/workout-sheet.test.ts --bundle --platform=node --outfile=.vercel/test/workout-sheet.test.cjs && node --test .vercel/test/workout-sheet.test.cjs",
        "hoja": "node --experimental-strip-types scripts/manage-sheet.mjs"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.11",
        "@supabase/supabase-js": "^2.90.1",
        "googleapis": "^169.0.0",
        "hono": "^4.9.3"
    },
    "devDependencies": {
        "@gltf-transform/core": "^4.5.1",
        "@gltf-transform/extensions": "^4.5.1",
        "@types/node": "^20.14.2",
        "draco3dgltf": "^1.5.7",
        "esbuild": "^0.27.2",
        "gl-matrix": "^3.4.4",
        "meshoptimizer": "^1.3.0",
        "typescript": "^5.4.5"
    }
}
